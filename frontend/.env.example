# Cesium Ion — set in shell or CI; never commit real tokens
VITE_CESIUM_TOKEN=

# Legacy alias (optional)
VITE_CESIUM_ION_TOKEN=

# Globe live WebSocket: gzip snapshots off by default (matches API WS_COMPRESS_SNAPSHOTS=false)
VITE_LIVE_WS_COMPRESS=false

# Optional explicit WS URLs when fronting with a custom domain / edge proxy
# VITE_WS_URL=wss://example.com/ws/live
# VITE_MARKET_HUB_WS=wss://example.com/ws/market-hub

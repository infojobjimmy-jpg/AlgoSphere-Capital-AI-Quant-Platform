{$ALGOSPHERE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy frontend:80

	# Discard access logs to avoid retaining visitor IP addresses.
	# Error-level diagnostics remain available via container stderr.
	log {
		output discard
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
